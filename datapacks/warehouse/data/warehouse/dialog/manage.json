{
  "type": "minecraft:multi_action",
  "title": {
    "text": "箱子管理"
  },
  "external_title": {
    "text": "箱子管理"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "選擇要管理的功能。"
      },
      "width": 360
    }
  ],
  "pause": false,
  "can_close_with_escape": true,
  "after_action": "close",
  "columns": 2,
  "actions": [
    {
      "label": {
        "text": "新增註冊"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_nav set 3"
      }
    },
    {
      "label": {
        "text": "刪除註冊"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_nav set 50"
      }
    },
    {
      "label": {
        "text": "命名箱子"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_nav set 60"
      }
    },
    {
      "label": {
        "text": "目前註冊"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_nav set 70"
      }
    },
    {
      "label": {
        "text": "背包箱 (01–05)"
      },
      "width": 150,
      "action": {
        "type": "show_dialog",
        "dialog": "warehouse:bag/manage"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "回主選單"
    },
    "width": 200,
    "action": {
      "type": "run_command",
      "command": "trigger wh_nav set 1"
    }
  }
}
