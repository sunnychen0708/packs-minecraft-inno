{
  "type": "minecraft:multi_action",
  "title": {
    "text": "自動分類倉庫"
  },
  "external_title": {
    "text": "自動分類倉庫"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "v3.4 - 自動分類、背景堆疊、箱子管理、分類設定、庫存查看、物品查詢。\n查詢可顯示目前分類箱是否已有該物品；移動分類會背景搬移舊主箱庫存。"
      },
      "width": 390
    }
  ],
  "pause": false,
  "can_close_with_escape": true,
  "after_action": "close",
  "columns": 2,
  "actions": [
    {
      "label": {
        "text": "箱子管理"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_action set 2"
      }
    },
    {
      "label": {
        "text": "查看倉庫"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_action set 7"
      }
    },
    {
      "label": {
        "text": "分類設定"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_nav set 40"
      }
    },
    {
      "label": {
        "text": "查詢物品"
      },
      "width": 150,
      "action": {
        "type": "show_dialog",
        "dialog": "warehouse:search"
      }
    },
    {
      "label": {
        "text": "使用說明"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_action set 6"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "關閉"
    },
    "width": 200
  }
}
