{
  "type": "minecraft:multi_action",
  "title": {
    "text": "背包箱管理"
  },
  "external_title": {
    "text": "背包箱管理"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "個人 /trigger bag；共用 /trigger sbag。A 箱存可交換物品，B 箱是空緩衝區。"
      },
      "width": 390
    }
  ],
  "pause": false,
  "can_close_with_escape": true,
  "after_action": "close",
  "columns": 2,
  "actions": [
    {
      "label": {
        "text": "註冊／換箱"
      },
      "width": 150,
      "action": {
        "type": "show_dialog",
        "dialog": "warehouse:bag/register"
      }
    },
    {
      "label": {
        "text": "取消註冊"
      },
      "width": 150,
      "action": {
        "type": "show_dialog",
        "dialog": "warehouse:bag/unregister"
      }
    },
    {
      "label": {
        "text": "使用說明"
      },
      "width": 150,
      "action": {
        "type": "show_dialog",
        "dialog": "warehouse:bag/help"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "返回箱子管理"
    },
    "width": 200,
    "action": {
      "type": "show_dialog",
      "dialog": "warehouse:manage"
    }
  }
}
