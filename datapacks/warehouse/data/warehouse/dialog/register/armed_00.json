{
  "type": "minecraft:multi_action",
  "title": {
    "text": "準備註冊箱子"
  },
  "external_title": {
    "text": "準備註冊"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "目前選擇：入口箱"
        }
      ],
      "width": 380
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "按「開始註冊」後介面會關閉。接著直接右鍵要綁定的大箱子任一半；完成後結果 Dialog 會自動出現。"
      },
      "width": 380
    }
  ],
  "pause": false,
  "after_action": "close",
  "columns": 2,
  "actions": [
    {
      "label": {
        "text": "開始註冊"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_action set 4"
      }
    },
    {
      "label": {
        "text": "取消"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_nav set 2"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "返回"
    },
    "width": 200,
    "action": {
      "type": "run_command",
      "command": "trigger wh_nav set 2"
    }
  },
  "can_close_with_escape": true
}
