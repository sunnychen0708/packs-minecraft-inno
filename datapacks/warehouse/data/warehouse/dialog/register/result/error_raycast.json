{
  "type": "minecraft:multi_action",
  "title": {
    "text": "沒有抓到箱子"
  },
  "external_title": {
    "text": "沒有抓到箱子"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "系統無法確認準星下的大箱。請站在約 6 格內，準星直接對準箱子後重試。"
      },
      "width": 360
    }
  ],
  "pause": false,
  "after_action": "close",
  "columns": 2,
  "actions": [
    {
      "label": {
        "text": "重試同一編號"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_action set 4"
      }
    },
    {
      "label": {
        "text": "回箱子註冊"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_nav set 2"
      }
    },
    {
      "label": {
        "text": "回主選單"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_nav set 1"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "關閉"
    },
    "width": 200
  },
  "can_close_with_escape": true
}
