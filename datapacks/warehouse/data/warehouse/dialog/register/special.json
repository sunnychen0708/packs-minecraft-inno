{
  "type": "minecraft:multi_action",
  "title": {
    "text": "入口箱"
  },
  "external_title": {
    "text": "入口箱"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "選擇要新增註冊的物品入口或區域溢位箱。"
      },
      "width": 430
    }
  ],
  "pause": false,
  "can_close_with_escape": true,
  "after_action": "close",
  "columns": 2,
  "actions": [
    {
      "label": {
        "text": "00 物品入口"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_register set 100"
      }
    },
    {
      "label": {
        "text": "10 一區溢位"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_register set 10"
      }
    },
    {
      "label": {
        "text": "20 二區溢位"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_register set 20"
      }
    },
    {
      "label": {
        "text": "30 三區溢位"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_register set 30"
      }
    },
    {
      "label": {
        "text": "40 四區溢位"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_register set 40"
      }
    },
    {
      "label": {
        "text": "50 五區溢位"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_register set 50"
      }
    },
    {
      "label": {
        "text": "60 六區溢位"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "trigger wh_register set 60"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "返回新增註冊"
    },
    "width": 200,
    "action": {
      "type": "show_dialog",
      "dialog": "warehouse:register"
    }
  }
}
